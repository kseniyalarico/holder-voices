# Copy this file to .env (root) and fill in real values.
# .env is gitignored — never commit real private keys.
#
# Foundry (contracts/) reads this file when invoked as:
#   source ../.env && forge script ...
# from inside contracts/. See README.md "Local Setup".

# ---- Monad Testnet network (verified from docs.monad.xyz) ----
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_WS_RPC_URL=wss://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# Optional: only needed if you verify manually instead of via the monskills
# verification API (see README "Verify contracts").
MONADSCAN_API_KEY=

# ---- Deployment (contracts/, scripts/) — LOCAL DEV ONLY ----
# Two supported ways to deploy/mint on Monad Testnet — pick one:
#  1. Your own funded test wallet: set DEPLOYER_PRIVATE_KEY below (this is
#     the account `forge script` broadcasts from and the TestCollection owner).
#     Fund it first via https://faucet.monad.xyz.
#  2. The monskills agent wallet: leave this blank. The agent's encrypted
#     keystore (~/.monskills/keystore) is decrypted on-the-fly per command,
#     with every transaction proposed through a Safe multisig for you to approve.
#     See README.md "Deploy to Monad Testnet".
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_TEST_KEY_ONLY

# ---- EIP-712 eligibility signer (backend, web/) ----
# Private key the backend uses to sign EligibilityProof structs.
# Never expose this to the frontend/browser.
ELIGIBILITY_SIGNER_PRIVATE_KEY=0xREPLACE_WITH_LOCAL_TEST_KEY_ONLY
# Corresponding public address, passed to HolderVoices constructor / setEligibilitySigner.
ELIGIBILITY_SIGNER_ADDRESS=0xREPLACE_WITH_SIGNER_ADDRESS

# ---- Database (packages/database) ----
# Postgres — a Neon database provisioned via Vercel's Storage tab works well
# and is used for both local dev and the hosted deployment (one DB, no drift).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Deployed contract addresses (filled in after `npm run deploy:*`) ----
HOLDER_VOICES_ADDRESS=
HOLDER_VOICES_DEPLOY_BLOCK=

# ---- Cron auth (web/app/api/cron/*) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Set the same value on Vercel and as the GitHub Actions secret CRON_SECRET.
CRON_SECRET=

# ---- Frontend (web/) public config — safe to expose in the browser ----
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONADVISION_URL=https://testnet.monadvision.com
NEXT_PUBLIC_MONADSCAN_URL=https://testnet.monadscan.com
NEXT_PUBLIC_HOLDER_VOICES_ADDRESS=
# Get a free project ID at https://cloud.walletconnect.com if you want WalletConnect
# (mobile wallets) in addition to injected wallets (MetaMask, Rabby, etc.).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
